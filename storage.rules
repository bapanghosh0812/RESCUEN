rules_version = '2';

// RESCUEN Cloud Storage security rules.
//
// The evidence vault holds the most sensitive data in the app — audio and
// AI-captured photos recorded during an active SOS. Devices may UPLOAD their
// own evidence, but NOTHING can be read back from a client. Retrieval is only
// possible through the trusted backend (Admin SDK) or the Firebase console.
// This is what "evidence is handled securely" must actually mean.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Profile photo — owner-only read & write.
    match /users/{userId}/profile/{allPaths=**} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId
                   && request.resource.size < 8 * 1024 * 1024;
    }

    match /users/{userId}/evidence_vault/{allPaths=**} {
      // Owner-only: ONLY the user whose Firebase Auth uid == {userId} can read or
      // write their own evidence. No other signed-in user, and no one on the
      // public internet, can ever access it. This is what makes the vault private.
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024; // 50 MB cap per object
    }

    // Default deny for everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
